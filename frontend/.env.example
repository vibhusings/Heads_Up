# mock = replay src/mocks/captured.json; real = call the backend (proxied to :8000 in dev)
VITE_API_MODE=real
# Leave empty to use the Vite dev proxy; set to e.g. http://127.0.0.1:8000 otherwise
VITE_API_BASE=
# Vapi: public key + ID of the saved assistant whose tools point at /api/voice/webhook
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
